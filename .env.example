OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=glm-4-air-250414
OPENAI_COMPAT_CHAT_PATH=/chat/completions
OPENAI_COMPAT_CA_CERT=
MINIMIND_BASE_URL=
MINIMIND_MODEL=
MINIMIND_API_KEY=sk-local
MINIMIND_CHAT_PATH=/chat/completions
MINIMIND_ENABLE_TRIAGE=false
MINIMIND_ENABLE_DRAFT_REPLY=true
RAG_ENABLED=true
RAG_EMBED_MODEL=BAAI/bge-small-zh-v1.5
RAG_DB_DIR=data/generated/rag
RAG_TOP_K=6
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_AUTH_CODE=
SMTP_USE_TLS=true
INCIDENT_EMAIL_TO=
KB_OPS_EMAIL_TO=
EMAIL_FROM_NAME=TicketFlow Agent

# Production service skeleton
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
# 本地单机开发可用 sqlite；生产服务路径使用 postgres。
DATABASE_BACKEND=sqlite
DATABASE_URL=postgresql://ticketflow:ticketflow@localhost:5432/ticketflow
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ticketflow-password
KG_BACKEND=disabled
SKILL_REGISTRY_BACKEND=repository
SKILLS_DIR=skills
ENABLE_SKILL_RUNTIME=true
MINIO_ENDPOINT=http://localhost:9000
ENABLE_PRODUCTION_SERVICES=false
